# Copy to .env.local and fill in. Never commit .env.local.
# Signer key: 0x + 64 hex. Leave blank to run without wallet features.
POLYMARKET_PRIVATE_KEY=
# Account wallet address from the polymarket.com profile menu (required if the key is set).
POLYMARKET_WALLET_ADDRESS=
# Relayer API key for gasless wallet operations (Enable trading). Secret; never commit.
# polymarket.com → Settings → API Keys → Relayer API Keys. ADDRESS is the Signer Address shown with it.
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=
# Server-side cap per order, in pUSD.
MAX_ORDER_USDC=25
# Polygon JSON-RPC for wallet operations (approvals). Must accept batches over 10 requests.
# Blank uses https://polygon-bor-rpc.publicnode.com.
POLYGON_RPC_URL=
PORT=3737
