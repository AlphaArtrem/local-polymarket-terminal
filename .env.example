# Copy to .env.local and fill in. Never commit .env.local.
# Signer key: 0x + 64 hex. Set it for key mode (the server signs). Leave blank for wallet mode
# (connect a browser wallet in the app).
POLYMARKET_PRIVATE_KEY=
# OPTIONAL override of the account wallet. Leave blank: it is found from the key (your Polymarket
# profile, else the key's own address as a plain EOA account). Set it only to force a specific wallet,
# e.g. the address from the polymarket.com profile menu. Ignored in wallet mode.
POLYMARKET_WALLET_ADDRESS=
# Relayer API key for gasless wallet operations (Enable trading). Secret; never commit.
# polymarket.com → Settings → API Keys → Relayer API Keys. ADDRESS is the Signer Address shown with it.
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=
# Server-side cap per order, in pUSD.
MAX_ORDER_USDC=25
# Polygon JSON-RPC for wallet operations (approvals). Must accept batches over 10 requests.
# Blank uses https://polygon-bor-rpc.publicnode.com.
POLYGON_RPC_URL=
# WARNING: true lets this app place take-profit/stop-loss and TWAP market orders by itself, unattended,
# while it runs (real money; each order still obeys MAX_ORDER_USDC). Leave false unless you want that.
AUTOMATION_ENABLED=false
# Where automation rules are stored, relative to the project folder. Blank uses .data/automation.json.
AUTOMATION_FILE=
PORT=3737
