{
  "name": "local-polymarket",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p ${PORT:-3737}",
    "start": "next start -H 127.0.0.1 -p ${PORT:-3737}",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "next build",
    "check-bundle": "node scripts/check-bundle.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run check-bundle",
    "doctor": "tsx scripts/doctor.ts"
  },
  "dependencies": {
    "@polymarket/client": "0.18.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "viem": "2.57.19",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
